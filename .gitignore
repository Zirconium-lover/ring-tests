# расчёта, чтобы незаконченные прогоны не попадали в коммиты
runs/stage1/*/
# журнал очереди дописывается во время серии; финальная версия добавляется явно
runs/stage1/queue.log
runs/stage2/decks/
runs/stage2/*/
# проверка числа сегментов: как этап 1 (прогоны добавляются явно после завершения)
runs/nseg/decks/
