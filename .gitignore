# большие результаты расчётов не храним
*.frd
*.12d
*.cvg
*.de1.vtk
runs/**/m.dat
runs/**/*.out
_scratch/
__pycache__/
# статьи (PDF) не кладём: репозиторий публичный
literature/**/*.pdf
*.pdf
# журналы прогонов большие; итоги переносятся в notes/
runs/**/run.log
