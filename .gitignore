# большие результаты расчётов не храним
*.frd
*.12d
*.cvg
*.de1.vtk
runs/**/m.dat
runs/**/*.out
_scratch/
__pycache__/
# статьи (PDF) не кладём: репозиторий публичный
literature/**/*.pdf
*.pdf
# журналы прогонов большие; итоги переносятся в notes/
runs/**/run.log
runs/**/m.cvg
runs/**/m.inp
runs/**/m.de1stats
runs/stage1/decks/
runs/stage1/.claims/
runs/**/post.log
# каталоги прогонов этапа 1 добавляются явно (git add -f) после завершения
# расчёта, чтобы незаконченные прогоны не попадали в коммиты
runs/stage1/*/
# журнал очереди дописывается во время серии; финальная версия добавляется явно
runs/stage1/queue.log
